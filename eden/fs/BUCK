load("@fbcode//cpe/nupkg_builder:nupkg.bzl", "nupkg")
load(
    "@fbcode//eden/fs:build_targets.bzl",
    "EDENFS_WINDOWS_DEPS",
    "make_rpm_features",
)
load("@fbcode//registry:defs.bzl", "rpm")
load("@fbcode_macros//build_defs:cpp_library.bzl", "cpp_library")
load("@fbcode_macros//build_defs:python_binary.bzl", "python_binary")
load("@fbsource//tools/build_defs:rust_binary.bzl", "rust_binary")
load("@fbsource//tools/build_defs:rust_library.bzl", "rust_library")

oncall("scm_client_infra")

cpp_library(
    name = "config",
    headers = ["eden-config.h"],
    exported_deps = [
        "//common/base:build_info_values",
    ],
)

rust_library(
    name = "mac_par_launcher",
    srcs = ["facebook/packaging/mac_par_launcher.rs"],
    compatible_with = ["ovr_config//os:macos"],
    crate = "mac_par_launcher",
    crate_root = "facebook/packaging/mac_par_launcher.rs",
    unittests = False,
)

rust_binary(
    name = "edenfs_config_manager",
    srcs = ["facebook/packaging/edenfs_config_manager_launcher.rs"],
    compatible_with = ["ovr_config//os:macos"],
    crate = "edenfs_config_manager",
    crate_root = "facebook/packaging/edenfs_config_manager_launcher.rs",
    unittests = False,
    deps = [":mac_par_launcher"],
)

rust_binary(
    name = "edenfs_restarter",
    srcs = ["facebook/packaging/edenfs_restarter_launcher.rs"],
    compatible_with = ["ovr_config//os:macos"],
    crate = "edenfs_restarter",
    crate_root = "facebook/packaging/edenfs_restarter_launcher.rs",
    unittests = False,
    deps = [":mac_par_launcher"],
)

rpm.builder(
    name = "fb-eden",
    # We are setting up conveyor+slowroll after which we can much lower this
    # limit. A higher limit is required for now to avoid weekly breakages as in
    # S209761.
    autoclean_keep_versions = 200,
    buck_opts = rpm.buck_opts(
        config = {
            # split-dwarf is required for reduce binary size
            "fbcode.split-dwarf": "true",
        },
    ),
    configurations = [
        rpm.configuration(
            arch = "x86_64",
            os = "linux",
        ),
        rpm.configuration(
            arch = "aarch64",
            os = "linux",
        ),
        rpm.configuration(
            arch = "noarch",
            os = "mac",
            repo = "darwin/any",
        ),
    ],
    features = make_rpm_features(),
    summary = "Source control aware virtual filesystem",
)

nupkg.builder(
    name = "fb-eden-windows",
    chocolatey_install_script = "facebook/packaging/chocolateyinstall.ps1",
    chocolatey_uninstall_script = "facebook/packaging/chocolateyuninstall.ps1",
    compatible_with = [
        "ovr_config//os:windows",
    ],
    # @lint-ignore BUCKLINT target-level oncall is required here
    oncall = "scm_client_infra",
    summary = "Source control aware virtual filesystem",
    deps = EDENFS_WINDOWS_DEPS,
)

python_binary(
    name = "generate_version_release",
    main_src = "scripts/generate_version_release.py",
)
