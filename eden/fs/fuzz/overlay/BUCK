overlay_read_path_annotations = [
    lh.PathAnnotation(
        alert = True,
        include_path_globs = [
            "fbcode/eden/fs/inodes/fscatalog/**/*",
        ],
        # loadRawOverlayDir is deliberately absent: it demangles as
        # loadRawOverlayDir[abi:cxx11] and never matches, and it sits between
        # the two symbols below on the same call path anyway.
        target_symbols = [
            "facebook::eden::FsFileContentStore::deserializeOverlayDir$",
            "facebook::eden::FsFileContentStore::validateHeader$",
        ],
    ),
]

