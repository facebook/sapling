    ],
)

python_binary(
    name = "interrupt_probe",
    srcs = ["tracing/interrupt_probe.py"],
    main_function = "eden.fs.cli.test.tracing.interrupt_probe.main",
    deps = [
        "//artillery/art_cli_lite:art_cli_lite_py",
        "//eden/fs/cli:main_lib",
    ],
)

python_unittest(
    name = "interrupt_exit_test",
    srcs = ["tracing/interrupt_exit_test.py"],
    env = {"INTERRUPT_PROBE": "$(location :interrupt_probe)"},
    labels = ci.labels(
        ci.linux(),
        ci.linux(ci.aarch64()),
        ci.mac(ci.aarch64()),
        ci.windows(),
    ),
    network_access = select({
        "DEFAULT": network_access_utils.NETWORK_ACCESS_ALL,
        "ovr_config//os:linux": network_access_utils.NETWORK_ACCESS_NONE,
        "ovr_config//os:macos": network_access_utils.NETWORK_ACCESS_LOOPBACK,
        "ovr_config//os:windows": network_access_utils.NETWORK_ACCESS_STRICT,
    }),
)

