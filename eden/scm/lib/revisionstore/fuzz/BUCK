rust_lionhead_harness(
    name = "lfs_blob_decode",
    srcs = ["fuzz_targets/lfs_blob_decode.rs"],
    annotations = [
        lh.PathAnnotation(
            alert = True,
            include_path_globs = REVISIONSTORE_PATH_GLOBS,
            target_symbols = [
                "revisionstore::lfs::LfsIndexedLogBlobsStore.?::get$",
                "revisionstore::lfs::LfsStore.?::get_blob$",
            ],
