load("@fbsource//xplat/security/lionhead:defs.bzl", "lh")
load("@fbsource//xplat/security/lionhead/build_defs:harness_rust.bzl", "rust_lionhead_harness")

oncall("sapling")

METADATA = lh.Metadata(
    exposure = lh.Exposure.EXTERNAL_USERS,
    project = "oncall_dynamic_analysis",
    severity_denial_of_service = lh.Severity.FILE_LOW_PRI_TASK,
    severity_service_takeover = lh.Severity.FILE_LOW_PRI_TASK,
)

# Run this with: arc lionhead harness run fbcode//eden/scm/lib/dag/fuzz:gca
# See D13660487.
rust_lionhead_harness(
    name = "gca",
    srcs = [
        "fuzz_targets/gca.rs",
        "fuzz_targets/tests.rs",
    ],
    autocargo = {
        "cargo_target_config": {"name": "gca"},
        "cargo_toml_config": {
            "extra_buck_dependencies": {
                # Cargo's libfuzzer-sys build script supplies the native runtime.
                "dependencies": [
                    (None, "fbsource//third-party/rust:libfuzzer-sys-libfuzzer"),
                ],
            },
            "package": {
                "license": "GPL-2.0-only",
                "metadata": {"cargo-fuzz": True},
                "name": "dag-fuzz",
                "publish": False,
                "version": "0.0.0",
            },
            "profile": {"release": {"debug": True}},
            "workspace": {"members": ["."]},
        },
    },
    crate_root = "fuzz_targets/gca.rs",
    metadata = METADATA,
    deps = [
        "//eden/scm/lib/dag/bindag:bindag",
    ],
)

