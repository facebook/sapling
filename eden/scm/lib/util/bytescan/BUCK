load("//eden/scm:targets.bzl", "sl_rust_library")

oncall("sapling")

sl_rust_library(
    name = "bytescan",
    srcs = glob(["src/**/*.rs"]),
    autocargo = {
        "cargo_toml_config": {
            "lib": {"name": "bytescan"},
            "package": {
                "authors": ["Meta Source Control Team <sourcecontrol-dev@meta.com>"],
                "description": "SIMD-accelerated byte scans for binary detection and line counting.",
                "homepage": "https://sapling-scm.com/",
                "license": "MIT",
                "name": "sapling-bytescan",
                "repository": "https://github.com/facebook/sapling",
            },
        },
    },
    crate_root = "src/lib.rs",
    deps = [
        "fbsource//third-party/rust:bytecount",
        "fbsource//third-party/rust:memchr",
    ],
)
