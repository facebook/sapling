load("@fbcode_macros//build_defs:cpp_binary.bzl", "cpp_binary")
load("@fbcode_macros//build_defs:cpp_library.bzl", "cpp_library")
load("@fbcode_macros//build_defs:custom_unittest.bzl", "custom_unittest")
load("//eden/scm:targets.bzl", "sl_rust_library")

oncall("sapling")

cpp_library(
    name = "sigbus_memops",
    srcs = [
        "native/sigbus_memops.c",
        "native/sigbus_memops_inline.c",
    ],
    headers = ["sigbus_memops.h"],
    header_namespace = "",
    private_headers = ["native/sigbus_memops_config.h"],
    compiler_flags = select({
        "DEFAULT": [],
        "ovr_config//os:windows": ["-fasync-exceptions"],
    }),
)

sl_rust_library(
    name = "sigbus-memops",
    srcs = glob(["src/**/*.rs"]),
    autocargo = {
        "cargo_toml_config": {
            "extra_buck_dependencies": {"build-dependencies": ["fbsource//third-party/rust:cc"]},
            "lib": {"name": "sigbus_memops"},
            "package": {
                "authors": ["Meta Source Control Team <sourcecontrol-dev@meta.com>"],
                "homepage": "https://sapling-scm.com/",
                "license": "MIT",
                "name": "sapling-sigbus-memops",
                "repository": "https://github.com/facebook/sapling",
            },
        },
    },
    crate_root = "src/lib.rs",
    test_deps = select({
        "DEFAULT": [],
        "ovr_config//os:linux": [
            "fbsource//third-party/rust:libc",
            "fbsource//third-party/rust:memmap2",
            "fbsource//third-party/rust:tempfile",
        ],
        "ovr_config//os:macos": [
            "fbsource//third-party/rust:libc",
            "fbsource//third-party/rust:memmap2",
            "fbsource//third-party/rust:tempfile",
        ],
    }),
    deps = [":sigbus_memops"],
)

cpp_binary(
    name = "sigbus_memops_test_bin",
    srcs = ["tests/sigbus_memops_test.c"],
    deps = [":sigbus_memops"],
)

custom_unittest(
    name = "sigbus_memops_test",
    command = ["$(exe :sigbus_memops_test_bin)"],
)

cpp_binary(
    # @autodeps-skip
    name = "sigbus_memops_fallback_test_bin",
    srcs = [
        "native/sigbus_memops.c",
        "native/sigbus_memops_inline.c",
        "tests/sigbus_memops_fallback_test.c",
    ],
    headers = [
        "native/sigbus_memops_config.h",
        "sigbus_memops.h",
    ],
    header_namespace = "",
    preprocessor_flags = ["-DSIGBUS_MEMOPS_FORCE_FALLBACK"],
)

custom_unittest(
    name = "sigbus_memops_fallback_test",
    command = ["$(exe :sigbus_memops_fallback_test_bin)"],
)
