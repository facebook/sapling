            "package": {
                "description": "Configure indexedlog using Sapling configuration.",
            },
        },
    },
    crate_root = "src/lib.rs",
    features = ["sigbus-handler"],
    deps = [
        "//eden/scm/lib/config/model:configmodel",
        "//eden/scm/lib/indexedlog:indexedlog",
    ],
)
