                "license": "MIT",
                "name": "sapling-fuzzutil",
                "repository": "https://github.com/facebook/sapling",
            },
        },
    },
    crate_root = "src/lib.rs",
    deps = [
        "fbsource//third-party/rust:tempfile",
        "//eden/scm/lib/indexedlog:indexedlog",
    ],
)
