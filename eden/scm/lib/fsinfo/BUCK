load("//eden/scm:targets.bzl", "sl_rust_binary", "sl_rust_library")

oncall("sapling")

sl_rust_library(
    name = "fsinfo",
    srcs = glob(["src/**/*.rs"]),
    autocargo = {},
    crate_root = "src/lib.rs",
    deps = [
        "fbsource//third-party/rust:anyhow",
    ] + select({
        "DEFAULT": [],
        "ovr_config//os:linux": [
            "fbsource//third-party/rust:libc",
        ],
        "ovr_config//os:macos": [
            "fbsource//third-party/rust:libc",
        ],
        "ovr_config//os:windows": [
            "fbsource//third-party/rust:winapi",
            "//eden/scm/lib/identity:identity",
        ],
    }),
)

sl_rust_binary(
    name = "fstype",
    srcs = ["examples/fstype.rs"],
    autocargo = {"ignore_rule": True},
    unittests = False,
    deps = [
        "fbsource//third-party/rust:anyhow",
        ":fsinfo",
    ],
)
