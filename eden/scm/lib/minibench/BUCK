load("//eden/scm:targets.bzl", "sl_rust_library")

oncall("sapling")

sl_rust_library(
    name = "minibench",
    srcs = glob(["src/**/*.rs"]),
    autocargo = {
        "cargo_toml_config": {
            "package": {
                "autoexamples": False,
                "description": "Minimal benchmark library.",
            },
        },
    },
    crate_root = "src/lib.rs",
)
