# Continuous CI only: `ci.remove(ci.diff, ci.land)` drops the inherited diff-
# and land-time CI labels and keeps the continuous ones (Citadel CI Label API
# Reference, "Removing Values"). `long_running` (100-minute tpx timeout tier): the
# 60 x 140-node batches take about 9 minutes against the 10-minute default.
python_unittest(
    name = "core_solver_scale_slow_test",
    srcs = ["core/test/solver_scale_slow_test.py"],
    compatible_with = ["ovr_config//os:linux"],
    labels = [tpx_labels.long_running] + ci.labels(ci.remove(ci.diff, ci.land)),
    network_access = network_access_utils.none(),
    deps = [
        ":engine_problems",
    ],
)

